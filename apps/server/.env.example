PORT=3001
MONGODB_URI=mongodb://localhost:27017/v0-by-kimi
REDIS_URL=redis://localhost:6379
JWT_SECRET=local-development-only-change-before-deploying
CLIENT_URL=http://localhost:5173
PREVIEW_PUBLIC_ORIGIN=http://localhost:3001
LOCAL_FULLSTACK_PREVIEW_ENABLED=false
LOCAL_FULLSTACK_PREVIEW_ROOT=/tmp/open-v0-fullstack-previews
LOCAL_PERSISTENT_DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/postgres
ARTIFACT_STORE_DRIVER=shared-filesystem
ARTIFACT_STORE_ROOT=/tmp/open-v0-artifacts
SANDBOX_PROVIDER=fake
SANDBOX_LOCAL_ENABLED=false
SANDBOX_LOCAL_ROOT=/tmp/open-v0-sandboxes
SANDBOX_ALLOWED_BUILD_IMAGES=node:22
SANDBOX_QUOTA_LOCK_TTL_MS=5000
SANDBOX_QUOTA_LOCK_WAIT_MS=2000
SANDBOX_READINESS_TIMEOUT_MS=60000
SANDBOX_LEASE_SECONDS=900
SANDBOX_AUTO_DELETE_SECONDS=1800
SANDBOX_ORPHAN_GRACE_MS=300000
SANDBOX_RECONCILE_INTERVAL_MS=30000
SANDBOX_HEARTBEAT_INTERVAL_MS=10000
SANDBOX_HEARTBEAT_TIMEOUT_MS=45000
SANDBOX_INSTALL_TIMEOUT_MS=180000
SANDBOX_TYPE_CHECK_TIMEOUT_MS=60000
SANDBOX_BUILD_TIMEOUT_MS=120000
NODE_ENV=development

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

AGENT_QUEUE_NAME=v0-agent-runs
AGENT_MODEL=
AGENT_DEFAULT_MODEL_ID=deepseek-flash
AGENT_MODELS_JSON=[{"id":"deepseek-flash","label":"DeepSeek V4 Flash","provider":"deepseek","model":"deepseek-v4-flash","baseURL":"https://api.deepseek.com","apiKeyEnv":"DEEPSEEK_API_KEY","description":"Fast model for iteration"},{"id":"deepseek-pro","label":"DeepSeek V4 Pro","provider":"deepseek","model":"deepseek-v4-pro","baseURL":"https://api.deepseek.com","apiKeyEnv":"DEEPSEEK_API_KEY","description":"Higher-quality model for complex changes"}]
AGENT_MAX_REPAIR_ATTEMPTS=2
AGENT_VALIDATION_EXECUTOR=legacy
AGENT_WORKSPACE_ROOT=/tmp/v0-agent-runs
AGENT_CONTEXT_CHAR_LIMIT=120000
AGENT_VALIDATION_NPM_CACHE_ROOT=/tmp/v0-agent-cache/npm
AGENT_VALIDATION_DEPENDENCY_CACHE_ROOT=/tmp/v0-agent-cache/dependencies
VALIDATION_DATABASE_IMAGE=postgres:16-alpine
VALIDATION_DATABASE_HOST=
