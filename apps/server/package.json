{
  "name": "@ai-app-builder-foundation/server",
  "version": "0.1.0-preview.1",
  "description": "API, agent runtime, build verification worker, and artifact services for AI App Builder Foundation",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:smoke-worker": "node dist/smokeWorker.js",
    "migrate:workspace-branches": "tsx src/migrate.ts",
    "start:migrate:workspace-branches": "node dist/migrate.js",
    "reconcile:artifacts": "tsx src/reconcileArtifacts.ts",
    "start:reconcile:artifacts": "node dist/reconcileArtifacts.js",
    "test": "node ../../scripts/run-node-tests.mjs src .test.ts",
    "test:integration": "node ../../scripts/run-node-tests.mjs src/integration .integration.ts --test-concurrency=1 && node ../../scripts/run-node-tests.mjs src/artifacts .integration.ts --test-concurrency=1 && node ../../scripts/run-node-tests.mjs src/sandbox .integration.ts --test-concurrency=1",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@daytona/sdk": "0.201.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.2",
    "morgan": "^1.11.0",
    "openai": "^7.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "testcontainers": "12.0.4",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0"
  }
}
