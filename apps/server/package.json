{
  "name": "@v0/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:smoke-worker": "node dist/smokeWorker.js",
    "migrate:workspace-branches": "tsx src/migrate.ts",
    "start:migrate:workspace-branches": "node dist/migrate.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"src/integration/**/*.integration.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.0",
    "morgan": "^1.10.0",
    "openai": "^4.28.4",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.2.2",
    "testcontainers": "10.13.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0"
  }
}
