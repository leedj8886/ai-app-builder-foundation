{
  "name": "ai-app-builder-foundation",
  "version": "0.1.0-preview.1",
  "description": "Open-source foundation for building self-hosted AI App Builders with auditable, build-verified generation",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "ai-app-builder",
    "coding-agent",
    "build-verification",
    "self-hosted",
    "prompt-to-app"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leedj8886/ai-app-builder-foundation.git"
  },
  "bugs": {
    "url": "https://github.com/leedj8886/ai-app-builder-foundation/issues"
  },
  "homepage": "https://github.com/leedj8886/ai-app-builder-foundation#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test:smoke:api": "tsx tests/smoke/api-smoke.ts",
    "test:smoke:browser": "playwright test tests/smoke/workspace.spec.ts",
    "test:smoke": "tsx tests/smoke/run-smoke.ts",
    "test:readiness": "node --import tsx --test tests/repository/open-source-readiness.test.ts",
    "demo:record": "tsx scripts/record-community-demo.ts",
    "daytona:init": "sh scripts/init-daytona-env.sh",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "tsx": "^4.23.1",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
