{
  "name": "ai-app-builder-foundation",
  "version": "0.1.0-preview.1",
  "description": "Open-source foundation for building self-hosted AI App Builders with auditable, build-verified generation",
  "private": true,
  "packageManager": "npm@10.9.3",
  "license": "Apache-2.0",
  "keywords": [
    "ai-app-builder",
    "coding-agent",
    "build-verification",
    "self-hosted",
    "prompt-to-app"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leedj8886/ai-app-builder-foundation.git"
  },
  "bugs": {
    "url": "https://github.com/leedj8886/ai-app-builder-foundation/issues"
  },
  "homepage": "https://github.com/leedj8886/ai-app-builder-foundation#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test:smoke:api": "tsx tests/smoke/api-smoke.ts",
    "test:smoke:browser": "playwright test tests/smoke/workspace.spec.ts",
    "test:smoke:browser:external": "playwright test tests/smoke/sandpack-external.spec.ts",
    "test:smoke": "tsx tests/smoke/run-smoke.ts",
    "test:smoke:external": "tsx tests/smoke/run-smoke.ts --suite external",
    "test:smoke:all": "tsx tests/smoke/run-smoke.ts --suite all",
    "test:readiness": "node --import tsx --test tests/repository/open-source-readiness.test.ts",
    "audit:dependencies": "node scripts/check-npm-audit.mjs",
    "demo:record": "tsx scripts/record-community-demo.ts",
    "demo:record:recovery": "tsx scripts/record-recovery-demo.ts",
    "daytona:init": "sh scripts/init-daytona-env.sh",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "tsx": "^4.23.1",
    "turbo": "2.10.8",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.3"
  },
  "overrides": {
    "form-data": "4.0.6",
    "path-to-regexp": "0.1.13"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
